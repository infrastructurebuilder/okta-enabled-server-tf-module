
#cloud-config
merge_how:
  - name: list
    settings: [append]
  - name: dict
    settings: [no_replace, recurse_list]

write_files:
  - encoding: b64
    content: ${playbook_base64}
    path: /root/update_users.yml
    permissions: '0600'

  - encoding: b64
    content: ${data_base64}
    path: /root/groups_and_users.json
    permissions: '0600'